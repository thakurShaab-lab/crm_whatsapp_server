NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=web_crm_whatsapp

# Single configured tbl_employees row stands in for real auth (not implemented in this build)
DEFAULT_EMPLOYEE_ID=6260
DEFAULT_USER_ADMIN_ID=6260

UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_VIDEO_MB=16
UPLOAD_MAX_DOCUMENT_MB=100
UPLOAD_MAX_AUDIO_MB=16

# Vendor APIs fetch media attachments themselves from this URL + the app's own
# /uploads static route — final URL shape:
# <PUBLIC_MEDIA_BASE_URL>/uploads/media/userfolder_<id>/whatsapp_sent_file/<filename>
# (do not append /uploads here — the app's own routes/paths already add that segment)
PUBLIC_MEDIA_BASE_URL=

# Folder uploaded files are written to and served from (via the /uploads route).
# Absolute in production; a bare relative name like "uploads" is fine for local dev.
UPLOAD_DIR=uploads
