# Single configured tbl_employees row stands in for real auth (not implemented in this build)
DEFAULT_EMPLOYEE_ID=6260
DEFAULT_USER_ADMIN_ID=6260

UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_VIDEO_MB=16
UPLOAD_MAX_DOCUMENT_MB=100
UPLOAD_MAX_AUDIO_MB=16

# Vendor APIs fetch media attachments themselves from this URL + the app's own
# /uploads static route — final URL shape:
# <PUBLIC_MEDIA_BASE_URL>/uploads/media/userfolder_<id>/whatsapp_sent_file/<filename>
# (do not append /uploads here — the app's own routes/paths already add that segment)
PUBLIC_MEDIA_BASE_URL=https://node.weblink4you.com/crm-whatsapp

# Folder uploaded files are written to and served from (via the /uploads route).
# Absolute in production (files live under this exact path on the server, outside
# any particular deploy/checkout directory); a bare relative name like "uploads" is
# fine for local dev, resolved against this process's cwd.
UPLOAD_DIR=/home/nodeapp/whatsapp_crm/uploads

# Paste this exact value into the "Verify Token" field when registering the webhook
# URL on AiSensy/Meta's dashboard — it's just a shared secret you invent, not
# something issued by them. See webhooksController.js's verifyWebhookSubscription.
WEBHOOK_VERIFY_TOKEN=e2155913e31cd5a1be035f25926c9eb55058d340d12f2423
